# --- Discord (https://discord.com/developers/applications) ---
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Optional: register slash commands to one server instantly (otherwise global, can take ~1h)
DISCORD_GUILD_ID=

# Channel name -> character. A "-no-memory" twin is used for the before/after comparison.
# Format: channelName:npcId:memory(on|off), comma separated
CHANNELS=forge:brannoc:on,drowned-lantern:mira:on,barracks:hale:on,forge-no-memory:brannoc:off

# --- Walrus Memory (https://memory.walrus.xyz -> create account + delegate key) ---
MEMWAL_PRIVATE_KEY=
MEMWAL_ACCOUNT_ID=
MEMWAL_SERVER_URL=https://relayer.memory.walrus.xyz
# Prefix for every namespace this game writes. Change it to start a fresh world.
MEMWAL_NS_PREFIX=blacksmith
# Recall hits at or above this cosine distance are treated as unrelated and dropped.
MEMWAL_MAX_DISTANCE=0.75
# Set to "mock" to run fully offline with the SDK's in-memory MemWalMock.
MEMWAL_MODE=live

# --- LLM: any OpenAI-compatible endpoint ---
# Default: Groq running qwen/qwen3.8-27b (free key at https://console.groq.com).
# Any OpenAI-compatible endpoint works (e.g. OpenRouter: https://openrouter.ai/api/v1).
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=qwen/qwen3.8-27b
# Optional cheaper/faster model for fact extraction (defaults to LLM_MODEL)
LLM_EXTRACT_MODEL=

# --- Storage for the outbox, attitudes and turn log ---
DATA_DIR=./data

# --- Optional: back up data/ to a private GitHub repo (for hosts without a persistent disk) ---
# Fine-grained token with Contents: read & write on that one repo only.
BACKUP_GITHUB_REPO=
BACKUP_GITHUB_TOKEN=
