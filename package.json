{
  "name": "blacksmith",
  "version": "0.1.0",
  "description": "A Discord text game whose characters remember every player across sessions, powered by Walrus Memory.",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "bot": "tsx src/discord.ts",
    "play": "tsx src/cli.ts",
    "register": "tsx src/register-commands.ts",
    "check": "tsx src/check.ts",
    "stats": "tsx src/stats.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "build": "tsc",
    "start": "node dist/src/discord.js"
  },
  "dependencies": {
    "@mysten-incubation/memwal": "^0.1.8",
    "@mysten/seal": "^1.4.18",
    "@mysten/sui": "^2.34.0",
    "discord.js": "^14.27.0",
    "openai": "^7.27.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
